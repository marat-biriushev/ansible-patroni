# {{ ansible_managed }}
# Для команд с аутентификацией: etcdctl --user root:<пароль> <команда>
# (только имя без пароля — etcdctl будет ждать ввода с клавиатуры)
export ETCDCTL_ENDPOINTS="{{ groups['etcd'] | map('extract', hostvars, 'cluster_node_ip') | map('regex_replace', '^(.*)$', 'https://\\1:' ~ etcd_client_port) | join(',') }}"
export ETCDCTL_CACERT="{{ etcd_pki_dir }}/ca.crt"
