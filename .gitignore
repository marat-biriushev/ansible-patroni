# Секреты: в репозитории хранится только vault.yml.example
inventories/*/group_vars/all/vault.yml
# Ключи CA и узлов, сгенерированные при pki_mode: selfsigned
inventories/*/pki/
# Коллекции лежат в collections/ (офлайн-установка), байткод не храним
__pycache__/
*.pyc
*.retry
.vault_pass*
# Офлайн-пакеты кладутся вручную, в git не храним
files/rpms/*.rpm
files/etcd/*.tar.gz
files/etcd/SHA256SUMS
